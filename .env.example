# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
APP_NAME=AI Job Interview Simulator

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interview_db
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI (optional: AI features are disabled with a clear message when unset)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# GitHub analysis (optional; raises API rate limit)
GITHUB_TOKEN=

# Voice (optional; app falls back to text-only mode)
VOICE_ENABLED=false
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# File storage: local (development) or s3 (production)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Observability (optional)
LANGSMITH_API_KEY=
SENTRY_DSN=

# URLs / CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
