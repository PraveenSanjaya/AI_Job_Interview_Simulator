# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
APP_NAME=AI Job Interview Simulator

# Used by docker-compose.yml for the local PostgreSQL container
POSTGRES_USER=interview
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=interview_db
# Must match the values above when using the compose database
DATABASE_URL=postgresql+asyncpg://interview:replace_with_a_strong_password@localhost:5432/interview_db
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI (optional: AI features are disabled with a clear message when unset)
# AI is optional. Set AI_PROVIDER=openai plus a key and model to enable CV analysis.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=
# Use another OpenAI-compatible server (e.g. a local one) by changing the base URL
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60
OPENAI_EMBEDDING_MODEL=

# GitHub analysis (optional; raises API rate limit)
GITHUB_TOKEN=

# Mock interviews (optional). Defaults shown; INTERVIEW_SCORING takes JSON overrides.
# INTERVIEW_DEFAULT_FOLLOWUPS=2
# INTERVIEW_MAX_FOLLOWUPS=3
# INTERVIEW_MAX_QUESTIONS=30
# INTERVIEW_IDLE_MINUTES=120
# INTERVIEW_CREATED_EXPIRY_HOURS=72
# INTERVIEW_SCORING={"followup_weight": 0.5, "skipped_counts_as_zero": true}

# Job matching (optional): override default scoring weights, as JSON. Dimensions:
# required_skills, preferred_skills, experience, education, project_relevance,
# technology_alignment, evidence_strength
# MATCH_WEIGHTS={"required_skills": 0.5, "education": 0.0}

# Voice (optional; app falls back to text-only mode)
VOICE_ENABLED=false
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# File storage: local (development) or s3 (production)
# local = development only; s3 is not implemented yet
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# Maximum accepted upload size in bytes (default 5 MiB)
MAX_UPLOAD_BYTES=5242880
# Cap for all other request bodies (JSON)
MAX_JSON_BODY_BYTES=1048576
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Observability (optional)
LANGSMITH_API_KEY=
SENTRY_DSN=

# URLs / CORS
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call the API, as a JSON list (FRONTEND_URL is always allowed)
# CORS_ALLOWED_ORIGINS=["https://app.example.com"]
BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Rate limiting (per-process limiter; shared through Redis when REDIS_URL is set)
# Retry of file removal after account deletion (0 = off; run `python -m app.cleanup` from cron)
FILE_CLEANUP_INTERVAL_SECONDS=300
RATE_LIMIT_ENABLED=true
# Failed sign-ins per account (all addresses together) before it is throttled
LOGIN_ACCOUNT_FAILURE_ATTEMPTS=50
LOGIN_ACCOUNT_FAILURE_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
