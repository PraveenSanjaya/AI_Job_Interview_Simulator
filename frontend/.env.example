# Base URL of the backend API. Leave unset in development: requests go to /api/v1 and the Vite
# dev server proxies them to VITE_DEV_API_TARGET (default http://localhost:8000).
# In production set the full API URL (the backend must allow this site's origin via
# FRONTEND_URL / CORS_ALLOWED_ORIGINS) or serve both behind one reverse proxy.
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_DEV_API_TARGET=http://localhost:8000
